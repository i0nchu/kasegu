# --- mode: paper | live (backtest runs better with `docker compose run`)
KASEGU_MODE=paper
# live needs an explicit opt-in, same as --confirm-live
KASEGU_CONFIRM_LIVE=0
KASEGU_CONFIG=configs/config.yaml
KASEGU_LOG_LEVEL=INFO
# optional rotating log file inside the data volume
# KASEGU_LOG_FILE=data/logs/kasegu.log

# --- Binance API (testnet or mainnet, see exchange.testnet in the config)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- optional Telegram alerts, enable with alerts.telegram: true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
